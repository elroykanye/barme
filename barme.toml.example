# Barme server config. Copy to barme.toml and edit; environment variables
# override these values. Point elsewhere with BARME_CONFIG=/path/to.toml.

data_dir = "./barme-data"

s3_addr = "0.0.0.0:9000"
native_addr = "0.0.0.0:7373"
cdn_addr = "0.0.0.0:7375"
console_addr = "0.0.0.0:7374"

cors_origins = ["*"]

# Where the BROWSER should reach the API and the CDN, if that is not
# http://<console host>:7373 and :7375.
#
# The console works out its own API base from the address bar, which is right
# when it is reached directly and wrong the moment anything is put in front of
# it: served from https://store.example.com it would call
# http://store.example.com:7373 — a port the proxy does not publish, over plain
# HTTP from an HTTPS page, which browsers block as mixed content.
#
# Set these when the console is published behind a reverse proxy, and route the
# paths to the native and CDN listeners. Leaving them unset keeps the derive-
# from-the-address-bar behaviour, which is what you want on localhost.
#
# Also settable as BARME_CONSOLE_API_URL / BARME_CONSOLE_CDN_URL.
# console_api_url = "https://store.example.com/api"
# console_cdn_url = "https://store.example.com/cdn"

# Garbage collection: how long a chunk stays condemned before erase, and how
# often the sweep runs.
gc_grace_secs = 86400
gc_interval_secs = 3600

# Semantic search (optional): point at an embedder speaking barme's contract.
# embed_url = "http://localhost:11434/embed"
# embed_model = "nomic-embed-text"

# Default storage policy for new writes (per-pot overrides land on top).
[default_policy]
codec = "zstd"
zstd_level = 0
tenant = "default"
policy_name = "default@v1"

# Bootstrap owner credential (or set BARME_ACCESS_KEY / BARME_SECRET_KEY).
# [credentials]
# access_key = "owner"
# secret_key = "change-me"
